{
  "name": "vendure-qa-automation",
  "version": "1.0.0",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:ui": "bddgen && playwright test --project=chromium",
    "test:mobile": "bddgen && playwright test --project=mobile-chrome",
    "test:api": "bddgen && playwright test --project=api",
    "report": "playwright show-report reports/playwright",
    "triage:report": "node scripts/qa-triage-report.js",
    "install:browsers": "playwright install --with-deps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "playwright",
    "bdd",
    "vendure",
    "qa-automation",
    "typescript"
  ],
  "author": "Nimantha Fernando",
  "license": "MIT",
  "description": "Playwright + BDD test automation framework for Vendure storefront UI, mobile web, and Shop GraphQL API coverage.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
