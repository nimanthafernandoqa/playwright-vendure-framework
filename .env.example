# Copy this file to .env and adjust for your local setup.
# .env is gitignored — never commit real credentials.

# Where the Vendure storefront (Next.js app) is reachable.
STOREFRONT_BASE_URL=http://localhost:3001

# Where the Vendure Shop GraphQL API is reachable (served by the Vendure
# server itself, not the storefront).
SHOP_API_URL=http://localhost:3000/shop-api

# Optional: only needed for the valid-login API scenario.
# Leave blank locally unless you have a safe seeded test customer.
API_USERNAME=
API_PASSWORD=
