# Copy this file to .env and adjust for your local setup.
# .env is gitignored — never commit real credentials.

# Where the Vendure storefront (Next.js app) is reachable.
STOREFRONT_BASE_URL=http://localhost:3001

# Where the Vendure server (Admin API + Shop API) is reachable.
ADMIN_BASE_URL=http://localhost:3000

# Credentials used by tests/api tests that call authenticated endpoints.
API_USERNAME=
API_PASSWORD=
